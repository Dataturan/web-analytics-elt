# Copy this file to .env and fill in your own values. Never commit .env.

# Google Cloud project that holds the BigQuery datasets (your personal project)
GCP_PROJECT=your-gcp-project-id

# BigQuery datasets
BQ_RAW_DATASET=raw
BQ_LOCATION=EU

# GA4 property to read (numeric ID, found under Admin > Property details)
GA4_PROPERTY_ID=123456789

# Public RSS feed of the site
RSS_URL=https://example.com/feed/

# Service account the pipeline acts as. No key file: you log in once with
#   gcloud auth application-default login --impersonate-service-account=<this email>
# and Google hands out short-lived tokens for it.
GCP_SERVICE_ACCOUNT=pipeline-runner@your-gcp-project-id.iam.gserviceaccount.com

# How many past days to re-fetch on every run (GA4 revises recent data)
LOOKBACK_DAYS=3
